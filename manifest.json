{
  "manifest_version": 3,
  "name": "Patreon Floating Element Toggle",
  "version": "1.0.0",
  "description": "Hide or show Patreon's floating engagement bar. Hidden by default.",
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "action": {
    "default_title": "Patreon floating element",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.patreon.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
