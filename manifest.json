{
  "manifest_version": 3,
  "name": "Patreon Floating Element Toggle",
  "version": "1.0.0",
  "description": "Hide or show a selected floating element on Patreon. Hidden by default.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.patreon.com/*"],
  "action": {
    "default_title": "Patreon floating element",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.patreon.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
