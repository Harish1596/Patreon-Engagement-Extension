{
  "manifest_version": 3,
  "name": "Patreon Reader",
  "version": "1.2.0",
  "description": "Customize Patreon reading with fonts, colors and spacing. Download accessible posts and collections as PDF, EPUB or Markdown.",
  "permissions": ["storage", "downloads", "offscreen", "alarms"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background/media.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["export/chooser.html", "export/chooser.js", "export/chooser.css", "export/collection-chooser.html", "export/collection-chooser.js", "export/collection-chooser.css"],
      "matches": ["https://www.patreon.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Patreon Reader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.patreon.com/*"],
      "css": ["content/content.css"],
      "js": ["shared/extension.js", "shared/zip.js", "shared/retry.js", "shared/pdf.js", "shared/pdf-client.js", "content/patreon-dom.js", "content/reader.js", "content/export.js", "content/archive-stream.js", "content/collection-export.js", "content/content.js"],
      "run_at": "document_start"
    }
  ]
}
